<?xml version="1.0" ?>
<robot name="robot" xmlns:drake="http://drake.mit.edu">
<!-- Primary gripper collision filter group, containing the principal gripper geometry. -->
<drake:collision_filter_group name="panda_east__gripper">
    <drake:member link="panda_east__robotiq_coupling_link"/>
    <drake:member link="panda_east__robotiq_85_base_link"/>
    <drake:member link="panda_east__robotiq_85_left_knuckle_link"/>
    <drake:member link="panda_east__robotiq_85_right_knuckle_link"/>
    <drake:member link="panda_east__robotiq_85_left_finger_link"/>
    <drake:member link="panda_east__robotiq_85_right_finger_link"/>
    <drake:member link="panda_east__robotiq_85_left_inner_knuckle_link"/>
    <drake:member link="panda_east__robotiq_85_right_inner_knuckle_link"/>
    <drake:member link="panda_east__robotiq_85_left_finger_tip_link"/>
    <drake:member link="panda_east__robotiq_85_right_finger_tip_link"/>
    <drake:member link="panda_east__finger_eef"/>
    <drake:member link="panda_east__camera_view_link"/>
    <drake:ignored_collision_filter_group name="panda_east__gripper"/>
  </drake:collision_filter_group>
  <!-- Collision filter group containing only the tool mount link. -->
  <drake:collision_filter_group name="panda_east__tool_mount">
    <drake:member link="panda_east__tool_mount_base_link"/>
    <drake:ignored_collision_filter_group name="panda_east__tool_mount"/>
  </drake:collision_filter_group>
  <link name="panda_east__robotiq_coupling_link">
    <inertial>
      <origin rpy="0 0 0" xyz="8.625E-08 -4.6583E-06 0.03145"/>
      <mass value="0.22652"/>
      <inertia ixx="0.00020005" ixy="-4.2442E-10" ixz="-2.9069E-10" iyy="0.00017832" iyz="-3.4402E-08" izz="0.00013478"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://test_models/franka_with_gripper/meshes/visual/robotiq_gripper_coupling.obj"/>
      </geometry>
    </collision>
  </link>
  <!-- Connect the gripper to its parent link -->
  <joint name="panda_east__robotiq_85_base_joint" type="fixed">
    <parent link="panda_east__robotiq_coupling_link"/>
    <child link="panda_east__robotiq_85_base_link"/>
    <origin rpy="0 -1.5708 0" xyz="0 0 0.0075"/>
  </joint>
  <link name="panda_east__robotiq_85_base_link">
    <!-- Cylinder base -->
    <collision>
      <origin rpy="1.5708 0 1.5708" xyz="0.019 0 0"/>
      <geometry>
        <cylinder length="0.0383" radius="0.038"/>
      </geometry>
    </collision>
    <!-- Main body -->
    <collision>
      <origin rpy="0 0 0" xyz="0.06415 0 0"/>
      <geometry>
        <box size="0.0517 0.1548 0.036"/>
      </geometry>
    </collision>
    <!-- East block -->
    <collision>
      <origin rpy="0 0 0" xyz="0.101 0.052741 0"/>
      <geometry>
        <box size="0.022 0.047 0.036"/>
      </geometry>
    </collision>
    <!-- West block -->
    <collision>
      <origin rpy="0 0 0" xyz="0.101 -0.052741 0"/>
      <geometry>
        <box size="0.022 0.047 0.036"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.636951"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000380" ixy="0.000000" ixz="0.000000" iyx="0.000000" iyy="0.001110" iyz="0.000000" izx="0.000000" izy="0.000000" izz="0.001171"/>
    </inertial>
  </link>
  <joint name="panda_east__robotiq_85_left_knuckle_joint" type="revolute">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__robotiq_85_left_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="3.141592653589793 0.0 0.0" xyz="0.05490451627 0.03060114443 0.0"/>
    <limit effort="1000" lower="0.0" upper="0.804" velocity="2.0"/>
  </joint>
  <joint name="panda_east__robotiq_85_right_knuckle_joint" type="continuous">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__robotiq_85_right_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.05490451627 -0.03060114443 0.0"/>
    <limit effort="1000" lower="-3.14" upper="3.14" velocity="100.0"/>
    <mimic joint="panda_east__robotiq_85_left_knuckle_joint"/>
  </joint>
  <link name="panda_east__robotiq_85_left_knuckle_link">
    <visual>
      <geometry>
        <mesh filename="package://test_models/franka_with_gripper/meshes/visual/robotiq_85_knuckle_link.obj"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.018491"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000009" ixy="-0.000001" ixz="0.000000" iyx="-0.000001" iyy="0.000001" iyz="0.000000" izx="0.000000" izy="0.000000" izz="0.000010"/>
