    <inertial>
      <mass value="0.019555"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000002" ixy="0.000000" ixz="0.000000" iyx="0.000000" iyy="0.000005" iyz="0.000000" izx="0.000000" izy="0.000000" izz="0.000006"/>
    </inertial>
  </link>
  <!-- Attach the base link to its parent -->
  <joint name="panda_east__camera_mount_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.036 0 0.027"/>
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__camera_mount_base_link"/>
  </joint>
  <link name="panda_east__camera_mount_base_link">
    <inertial>
      <mass value="0.0015"/>
      <inertia ixx="3.987e-5" ixy="0.0" ixz="0.0" iyy="6.629e-4" iyz="0.0" izz="7.024e-4"/>
    </inertial>
    <collision>
      <origin rpy="0 3.141592653589793 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://test_models/franka_with_gripper/meshes/collision/robotiq_85_camera_mount.obj"/>
      </geometry>
    </collision>
  </link>
  <!-- Attach the base link to its parent -->
  <joint name="panda_east__tool_mount_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.036 0 -0.027"/>
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__tool_mount_base_link"/>
  </joint>
  <link name="panda_east__tool_mount_base_link">
