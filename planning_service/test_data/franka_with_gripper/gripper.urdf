  </link>
  <joint name="panda_east__tool_mount_attach_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.03 0 -0.019"/>
    <parent link="panda_east__tool_mount_base_link"/>
    <child link="panda_east__tool_mount_attach_link"/>
  </joint>
  <link name="panda_east__tool_mount_attach_link"/>
  <!-- Links -->
  <link name="camera_bottom_screw_frame"/>
  <link name="camera_link">
    <collision>
      <!-- TODO: X and Y coordinate correct, the Z should be set to 0 once the semantics are loaded through the
          description API -->
      <!-- <origin xyz="${d405_zero_depth_to_glass-d405_cam_depth/2} ${-d405_cam_depth_py} -${d405_cam_height/5}" rpy="0 0 0"/> -->
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <!-- TODO: To be reupdated to original value when the semantics are loaded through the description API -->
        <box size="0.023 0.042 0.042"/>
        <!-- <box size="${d405_cam_depth} ${d405_cam_width} ${d405_cam_height*0.6}"/> -->
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <link name="camera_depth_frame"/>
  <link name="camera_depth_optical_frame"/>
  <link name="camera_infra1_frame"/>
  <link name="camera_infra1_optical_frame"/>
  <link name="camera_infra2_frame"/>
  <link name="camera_infra2_optical_frame"/>
  <link name="camera_color_frame"/>
  <link name="camera_color_optical_frame"/>
  <!-- Joints -->
  <!-- The position of the camera body is either given by the position parameters (sensor_xyz, sensor_rpy). Or by a
    config file calibration_camera_extrinsic -->
  <joint name="camera_joint" type="fixed">
    <origin rpy="3.141592653589793 0 0" xyz="0.06460 -0.009 0.04048"/>
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="camera_link"/>
  </joint>
  <!-- TODO: handle the camera_parameters_file -->
  <joint name="camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.01085 -0.009 -0.021"/>
    <parent link="camera_link"/>
    <child link="camera_bottom_screw_frame"/>
  </joint>
  <!-- camera depth joints and links -->
  <joint name="camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <!-- camera left IR joints and links -->
  <joint name="camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="camera_link"/>
    <child link="camera_infra1_frame"/>
  </joint>
  <joint name="camera_infra1_optical_joint" type="fixed">
