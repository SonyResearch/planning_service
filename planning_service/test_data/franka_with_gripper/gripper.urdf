      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000039" ixy="0.000000" ixz="0.000000" iyx="0.000000" iyy="0.000005" iyz="0.000000" izx="0.000000" izy="0.000000" izz="0.000035"/>
    </inertial>
  </link>
  <!-- Connect the left and right finger frames to the gripper -->
  <joint name="panda_east__robotiq_85_left_finger_tip_joint" type="continuous">
    <parent link="panda_east__robotiq_85_left_inner_knuckle_link"/>
    <child link="panda_east__robotiq_85_left_finger_tip_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.04303959807 -0.03759940821 0.0"/>
    <limit effort="0.1" lower="-3.14" upper="3.14" velocity="100.0"/>
    <mimic joint="panda_east__robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="panda_east__robotiq_85_right_finger_tip_joint" type="continuous">
    <parent link="panda_east__robotiq_85_right_inner_knuckle_link"/>
    <child link="panda_east__robotiq_85_right_finger_tip_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.04303959807 -0.03759940821  0.0"/>
    <limit effort="0.1" lower="-3.14" upper="3.14" velocity="100.0"/>
    <mimic joint="panda_east__robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
