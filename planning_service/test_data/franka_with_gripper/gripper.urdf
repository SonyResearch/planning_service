        <mesh filename="package://test_models/franka_with_gripper/meshes/collision/robotiq_85_basic_finger_tip_link.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.019555"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000002" ixy="0.000000" ixz="0.000000" iyx="0.000000" iyy="0.000005" iyz="0.000000" izx="0.000000" izy="0.000000" izz="0.000006"/>
    </inertial>
  </link>
  <link name="panda_east__robotiq_85_right_finger_tip_link">
    <visual>
      <geometry>
