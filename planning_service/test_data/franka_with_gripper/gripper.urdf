    <parent link="camera_infra1_frame"/>
    <child link="camera_infra1_optical_frame"/>
  </joint>
  <!-- camera right IR joints and links -->
  <joint name="camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.018 0"/>
    <parent link="camera_link"/>
    <child link="camera_infra2_frame"/>
  </joint>
  <joint name="camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_infra2_frame"/>
    <child link="camera_infra2_optical_frame"/>
  </joint>
  <!-- camera color joints and links -->
  <joint name="camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
  </joint>
  <joint name="camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <link name="panda_east__finger_eef"/>
  <joint name="panda_east__finger_eef_joint" type="fixed">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__finger_eef"/>
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.162 0 0"/>
  </joint>
  <link name="panda_east__camera_view_link"/>
  <joint name="panda_east__camera_view_joint" type="fixed">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__camera_view_link"/>
