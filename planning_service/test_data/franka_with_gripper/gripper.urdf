  </link>
  <joint name="panda_east__robotiq_85_left_inner_knuckle_joint" type="continuous">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__robotiq_85_left_inner_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="3.141592653589793 0.0 0.0" xyz="0.06142 0.0127 0"/>
    <limit effort="0.1" lower="-3.14" upper="3.14" velocity="100.0"/>
    <mimic joint="panda_east__robotiq_85_left_knuckle_joint" offset="0"/>
  </joint>
  <joint name="panda_east__robotiq_85_right_inner_knuckle_joint" type="continuous">
    <parent link="panda_east__robotiq_85_base_link"/>
    <child link="panda_east__robotiq_85_right_inner_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0.06142 -0.0127 0"/>
    <limit effort="0.1" lower="-3.14" upper="3.14" velocity="100.0"/>
    <mimic joint="panda_east__robotiq_85_left_knuckle_joint" offset="0"/>
