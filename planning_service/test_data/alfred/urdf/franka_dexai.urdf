        </image>
        <clip>
          <near>0.105</near>
          <far>10</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>0</visualize>
    </sensor>
  </gazebo>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="realsense_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="realsense_base_link"/>
    <child link="realsense_bottom_screw_frame"/>
  </joint>
  <link name="realsense_bottom_screw_frame"/>
  <joint name="realsense_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0175 0.0125"/>
    <parent link="realsense_bottom_screw_frame"/>
    <child link="realsense_link"/>
  </joint>
  <link name="realsense_link">
    <visual>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.003 -0.0175 0"/>
      <geometry>
        <!-- <box size="${d435_cam_width} ${d435_cam_height} ${d435_cam_depth}"/> -->
        <!-- Mesh is offset due to offset location of realsense frames. -->
        <mesh filename="meshes/visual/d435.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.564"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="realsense_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="realsense_link"/>
    <child link="realsense_depth_frame"/>
  </joint>
  <link name="realsense_depth_frame"/>
  <joint name="realsense_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_depth_frame"/>
    <child link="realsense_depth_optical_frame"/>
  </joint>
  <link name="realsense_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="realsense_left_ir_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="realsense_depth_frame"/>
    <child link="realsense_left_ir_frame"/>
  </joint>
  <link name="realsense_left_ir_frame"/>
  <joint name="realsense_left_ir_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_left_ir_frame"/>
    <child link="realsense_left_ir_optical_frame"/>
  </joint>
  <link name="realsense_left_ir_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="realsense_right_ir_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="realsense_depth_frame"/>
    <child link="realsense_right_ir_frame"/>
  </joint>
  <link name="realsense_right_ir_frame"/>
  <joint name="realsense_right_ir_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_right_ir_frame"/>
    <child link="realsense_right_ir_optical_frame"/>
  </joint>
  <link name="realsense_right_ir_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="realsense_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="realsense_depth_frame"/>
    <child link="realsense_color_frame"/>
  </joint>
  <link name="realsense_color_frame"/>
  <joint name="realsense_color_uncorrected_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_color_frame"/>
    <child link="realsense_uncorrected_color_optical_frame"/>
  </joint>
  <link name="realsense_uncorrected_color_optical_frame"/>
  <joint name="realsense_color_optical_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <parent link="realsense_uncorrected_color_optical_frame"/>
    <child link="realsense_color_optical_frame"/>
  </joint>
  <link name="realsense_color_optical_frame"/>
  <link name="realsense_tag_alignment_frame"/>
  <joint name="realsense_color_tag_joint" type="fixed">
    <origin rpy="0 3.141592653589793 0" xyz="0 0 0"/>
    <parent link="realsense_color_optical_frame"/>
    <child link="realsense_tag_alignment_frame"/>
  </joint>
  <drake:collision_filter_group name="base">
    <drake:member link="base_link"/>
    <drake:member link="js_franka_base_assem"/>
    <drake:member link="cg_base"/>
    <drake:member link="franka_robot_base"/>
    <drake:member link="franka_link0"/>
    <drake:member link="franka_link1"/>
    <drake:member link="franka_link2"/>
    <drake:member link="franka_link3"/>
    <drake:member link="franka_link4"/>
    <drake:ignored_collision_filter_group name="base"/>
  </drake:collision_filter_group>
  <drake:collision_filter_group name="end_effector">
    <drake:member link="franka_link5"/>
    <drake:member link="franka_link6"/>
    <drake:member link="franka_link7"/>
    <drake:member link="franka_link8"/>
    <drake:member link="franka_head"/>
    <drake:member link="franka_head_fangs"/>
    <drake:member link="franka_head_box"/>
    <drake:member link="realsense_base_link"/>
    <drake:member link="realsense_link"/>
    <drake:ignored_collision_filter_group name="end_effector"/>
  </drake:collision_filter_group>
</robot>

