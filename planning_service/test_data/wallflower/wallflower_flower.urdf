<?xml version="1.0"?>
<robot name="robot">

<material name="marble">
  <color rgba="0.9 0.9 1.0 1"/>
</material>

<material name="granite">
  <color rgba="0.1 0.4 0.2 1"/>
</material>

  <link name="base_link">
    <collision>
      <geometry>
       <box size="0.2 0.2 0.1"/> </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.19 0.19 0.09"/> </geometry>
      <material name="marble"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="shaft"/>
    <axis xyz="0 0 1"/> 
    <origin rpy="0 0 0" xyz="0.0 0.0 0.22"/>
    <limit effort="10" lower="-3.2" upper="3.2" velocity="2.1750"/>
  </joint>

  <link name="shaft">
    <collision>
      <geometry>
        <cylinder length="0.4" radius="0.1"/> </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder length="0.39" radius="0.09"/> </geometry>
      <material name="marble"/>
    </visual>
  </link>

  <joint name="joint_shaft_piston" type="fixed">
    <parent link="shaft"/>
    <child link="piston"/>
    <origin rpy="0 1.57 0" xyz="0.3 0.0 0.0"/>
  </joint>

  <link name="piston">
    <collision>
      <geometry>
        <cylinder length="0.4" radius="0.02"/> </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder length="0.39" radius="0.019"/> </geometry>
      <material name="marble"/>
    </visual>
  </link>

  <joint name="joint_piston_ball" type="prismatic">
    <parent link="piston"/>
    <child link="ball"/>
    <axis xyz="0 0 1"/> 
    <limit effort="10" lower="0.2" upper="0.4" velocity="2.1750"/>
  </joint>

  <link name="ball">
    <collision>
      <geometry>
        <sphere radius="0.1"/> </geometry>
    </collision>
    <visual>
      <geometry>
        <sphere radius="0.09"/> </geometry>
      <material name="granite"/>
    </visual>
  </link>

</robot>
